---
import '../styles/global.css';
import Header from '../components/core/Header.astro';
import Footer from '../components/core/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Notes on agents, kernels, and the systems in between.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <slot name="head" />
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      document.querySelectorAll('pre:not(.mermaid)').forEach(pre => {
        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.textContent = 'copy';
        btn.setAttribute('aria-label', 'Copy code');
        btn.addEventListener('click', async () => {
          const code = pre.querySelector('code');
          if (code) {
            await navigator.clipboard.writeText(code.textContent || '');
            btn.textContent = 'copied!';
            setTimeout(() => { btn.textContent = 'copy'; }, 2000);
          }
        });
        pre.appendChild(btn);
      });
    </script>
    <script>
      const mermaidBlocks = document.querySelectorAll('pre.mermaid');
      if (mermaidBlocks.length > 0) {
        const mermaid = (await import('mermaid')).default;

        // theme: 'base' gives an empty canvas — no built-in dark/light defaults
        // override our themeVariables. This matters because mermaid's 'dark'
        // theme silently overrides primaryColor/primaryBorderColor with its own
        // greys, which desyncs diagrams from the site's Linear-style palette.
        // All colors below come from src/styles/global.css design tokens.
        const palette = (isLight) =>
          isLight
            ? {
                background: '#FFFFFF',
                primaryColor: '#F3F4F6',     // bg hover-ish
                primaryTextColor: '#08090A',  // fg-primary
                primaryBorderColor: '#D1D5DB',// border
                lineColor: '#5E6AD2',         // accent-primary
                secondaryColor: '#E5E7EB',
                tertiaryColor: '#F7F8F8',
                clusterBkg: '#FFFFFF',
                clusterBorder: '#2A2D33',
                titleColor: '#08090A',
                edgeLabelBackground: '#FFFFFF',
              }
            : {
                background: '#08090A',        // bg-primary
                primaryColor: '#1C1C1F',      // bg-tertiary (code block bg)
                primaryTextColor: '#F7F8F8',   // fg-primary
                primaryBorderColor: '#3A3D44', // border-strong
                lineColor: '#5E6AD2',          // accent-primary
                secondaryColor: '#16171A',     // bg-hover
                tertiaryColor: '#0F1011',      // bg-secondary
                clusterBkg: '#0F1011',         // bg-secondary
                clusterBorder: '#2A2D33',      // border-default
                titleColor: '#F7F8F8',
                edgeLabelBackground: '#0F1011',
              };

        // Capture each block's source up front (run() consumes it) so we can
        // re-render from scratch whenever the theme changes.
        const sources = Array.from(mermaidBlocks).map((pre, i) => ({
          id: `mermaid-svg-${i}`,
          pre,
          src: pre.textContent ?? '',
        }));

        // Render every block against the current theme into its <pre>. Called
        // once on load and again on each theme toggle, so a diagram never ends
        // up stale (e.g. a dark diagram on a light background after a switch).
        const renderWithTheme = async () => {
          const isLight = document.documentElement.getAttribute('data-theme') === 'light';
          mermaid.initialize({
            startOnLoad: false,
            theme: 'base',
            fontFamily: 'var(--font-mono)',
            themeVariables: { darkMode: !isLight, ...palette(isLight) },
          });
          for (const { id, pre, src } of sources) {
            try {
              const { svg } = await mermaid.render(id, src);
              pre.innerHTML = svg;
            } catch {
              // leave previous render in place if a re-render fails
            }
          }
        };

        await renderWithTheme();

        // ThemeToggle flips data-theme on <html>; re-render in response.
        new MutationObserver(renderWithTheme).observe(document.documentElement, {
          attributeFilter: ['data-theme'],
        });
      }
    </script>
  </body>
</html>
